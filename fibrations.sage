# This file contains the computational data for the paper # Simon Brandorst and Noam D. Elkies, Equations for a K3 Lehmer map # It is meant to be read by the computer algebra system SageMath Version 9.2. # https://www.sagemath.org/ # using the command `load('fibrations.sage')` # After execution the following global variables are available # E1, E2, E3, E4, E5, E6, E7 # which are elliptic fibrations in Weierstrass form giving the surface $S_i$ # and a basis of their Mordell-Weil group # basis1, basis2, basis3, basis4, basis5, basis6, basis7 # Reduction modulo p29 can be carried out by typing # e.g. E1.change_ring(kFt) # basis1_k = [b.change_ring(kFt) for b in basis1] # definitions of the base rings involved k = GF(29) R. = QQ[] fz = z^12 - 3*z^11 + z^10 + 7*z^9 - 8*z^8 - 4*z^7 + 13*z^6 - 4*z^5 - 8*z^4 + 7*z^3 + z^2 - 3*z + 1 F. = QQ.extension(fz) p29 = F.fractional_ideal(29, z+12) kF = p29.residue_field() Ft. = F[] Ft = Ft.fraction_field() kFt = PolynomialRing(kF,"t") kt = PolynomialRing(k,"t") R. = QQ[] fw = x^6 - 2*x^5 + 2*x^4 - 3*x^3 + 2*x^2 - 2*x + 1 w = z^11 - z^10 - 3*z^9 + 4*z^8 + 5*z^7 - 6*z^6 - 2*z^5 + 7*z^4 + z^3 - 4*z^2 + z + 2 zeta7 = 2*z^11 - 4*z^10 - 3*z^9 + 14*z^8 - 4*z^7 - 16*z^6 + 16*z^5 + 8*z^4 - 14*z^3 + 2*z^2 + 6*z - 2 assert w.minpoly()==fw assert zeta7.minpoly() == x^6 + x^5 + x^4 + x^3 + x^2 + x + 1 ################################################################################ # S1 ################################################################################ ainvs1 = (0, 0, 0, -3577/6*w^5 + 85943/48*w^4 - 8387/2*w^3 + 649*w^2 - 6917/2*w + 16741/6, (105*w^5 - 49*w^4 + 147*w^3 - 77*w^2 + 98*w - 63)*t^7 - 1593263/144*w^5 + 9754283/144*w^4 + 37139795/864*w^3 + 6866335/144*w^2 - 10692829/432*w - 18488981/864) E1 = EllipticCurve(Ft, ainvs1) B = [(-w^5 + 2*w^4 - 2*w^3 + 3*w^2 - w + 3)*t^4 + (-4*w^5 + 4*w^4 - 6*w^3 + 14*w^2 + 2*w + 12)*t^3 + (-14*w^5 + 9*w^4 - 4*w^3 + 38*w^2 + 13*w + 25)*t^2 + (-35*w^5 + 21*w^4 + 5*w^3 + 83*w^2 + 25*w + 24)*t - 48*w^5 + 169/3*w^4 + 20/3*w^3 + 989/12*w^2 - 8*w + 61/3, (-3*w^5 + 4*w^4 - 2*w^3 + 7*w^2 - w + 4)*t^6 + (-30*w^5 + 48*w^4 - 33*w^3 + 66*w^2 - 27*w + 42)*t^5 + (-102*w^5 + 183*w^4 - 150*w^3 + 477/2*w^2 - 225/2*w + 369/2)*t^4 + (-190*w^5 + 387*w^4 - 404*w^3 + 517*w^2 - 253*w + 487)*t^3 + (-157/2*w^5 + 186*w^4 - 401*w^3 + 931/2*w^2 + 11/2*w + 661)*t^2 + (191/2*w^5 - 587/2*w^4 - 8*w^3 + 439/2*w^2 + 515*w + 801/2)*t + 146*w^5 - 1241/2*w^4 + 537*w^3 - 152*w^2 + 1689/2*w - 255/2, 1] B = E1(B) basis1 =[(B[0].subs(t=t*zeta7^i),B[1].subs(t=t*zeta7^i)) for i in range(6)] basis1 = [E1(b) for b in basis1] ################################################################################ # S2 ################################################################################ ainvs2 = (0, 0, 0, (-161213/12*z^11 + 405085/16*z^10 + 165209/8*z^9 - 1254321/16*z^8 + 236675/48*z^7 + 1404859/16*z^6 - 2953057/48*z^5 - 1240577/24*z^4 + 240741/4*z^3 + 15124/3*z^2 - 533581/24*z + 100095/16)*t^8 + (9599*z^11 - 35315/2*z^10 - 41203/3*z^9 + 316819/6*z^8 - 17761/3*z^7 - 105915/2*z^6 + 271877/6*z^5 + 80242/3*z^4 - 114451/3*z^3 + 16691/6*z^2 + 67001/6*z - 7259)*t^7 + (-82943/6*z^11 + 31061*z^10 + 62917/6*z^9 - 537553/6*z^8 + 123032/3*z^7 + 266347/3*z^6 - 330875/3*z^5 - 59573/2*z^4 + 536741/6*z^3 - 154879/6*z^2 - 98209/3*z + 103567/6)*t^6 + (2719*z^11 - 4816*z^10 - 4631*z^9 + 16052*z^8 - 351*z^7 - 18912*z^6 + 13172*z^5 + 12887*z^4 - 12131*z^3 - 938*z^2 + 6320*z - 64)*t^5 + (435*z^11 - 1285*z^10 + 220*z^9 + 3375*z^8 - 3120*z^7 - 2840*z^6 + 5630*z^5 - 345*z^4 - 4230*z^3 + 2100*z^2 + 1305*z - 1095)*t^4, (31812991/432*z^11 + 283481275/864*z^10 - 664404503/864*z^9 - 518927143/864*z^8 + 636767341/288*z^7 + 42231917/108*z^6 - 656886265/288*z^5 + 522955601/432*z^4 + 538328525/288*z^3 - 919781891/864*z^2 - 55302779/108*z + 183661289/432)*t^12 + (12100745/36*z^11 - 24719075/18*z^10 + 37645145/72*z^9 + 130954051/36*z^8 - 22549645/6*z^7 - 130046729/36*z^6 + 53121164/9*z^5 - 8915393/36*z^4 - 122892235/24*z^3 + 1207917